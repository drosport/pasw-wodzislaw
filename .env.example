# Skopiuj do .env.local i uzupełnij. Plik .env.local nie trafia do repozytorium.

# Adres produkcyjny strony. Z tej wartości budowane są sitemap.xml,
# robots.txt oraz adresy kanoniczne w metadanych.
NEXT_PUBLIC_ADRES_STRONY=https://drosport.pl

# Wysyłka formularza zgłoszeniowego przez Resend.
# Bez tych trzech zmiennych formularz zwraca komunikat, że nie jest
# podłączony do skrzynki, a treść zgłoszenia trafia do logów serwera.
RESEND_API_KEY=
# Adres nadawcy musi należeć do domeny zweryfikowanej u dostawcy poczty.
ADRES_NADAWCY=formularz@drosport.pl
# Adres, na który trafiają zgłoszenia. Domyślnie KONTAKT.email z lib/dane.ts.
ADRES_ODBIORCY=

# ------------------------------------------------------------------
# Przelewy24
# ------------------------------------------------------------------
# Dane z panelu Przelewy24, zakładka Moje dane oraz Konfiguracja.
# Dopóki nie są ustawione, kreator zapisu zapisuje zgłoszenie i informuje
# użytkownika, że płatności online nie są jeszcze uruchomione.
P24_MERCHANT_ID=
# Zwykle taki sam jak merchant id, chyba że korzystasz z wielu punktów.
P24_POS_ID=
P24_CRC=
P24_API_KEY=
# true kieruje ruch do środowiska testowego sandbox.przelewy24.pl
P24_SANDBOX=false
